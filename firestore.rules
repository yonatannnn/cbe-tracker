rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Books are filed by the user's NAME, not by device, so any signed-in
    // install of the app may read and write them — that is what lets a
    // reinstall or a second phone typing the same name see the same
    // branches. Sign-in is anonymous, so this keeps out anyone who is not
    // running the app; it does not separate one name from another. Fine for
    // a private single-client build; not for a public one.
    match /users/{userKey}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
